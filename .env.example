# Master key for encrypting Canvas token vault (32+ bytes recommended).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
GRADING_SECRET_KEY=change-me-to-a-long-random-secret

# Optional: seed vault from env instead of UI (still encrypted on first load).
# Prefer UI password field; never commit a real token.
# CANVAS_TOKEN=

# Canvas API base (formal SJTU oc)
CANVAS_BASE_URL=https://oc.sjtu.edu.cn/api/v1
CANVAS_HOST=oc.sjtu.edu.cn

# Bind address — localhost only by default
HOST=127.0.0.1
PORT=8765

# Question bank PDF (local/ is gitignored)
QUESTION_BANK_PDF=local/question-bank.pdf

# Writeback gate: keep at 1 until first verified real writeback succeeds
WRITEBACK_MAX_BATCH=1

# Optional multimodal model key; if unset, deterministic rule engine + stub runs
# OPENAI_API_KEY=
# MODEL_API_KEY=

# SQLite path for run store
DATABASE_PATH=local/grading.db

# Vault ciphertext path
VAULT_PATH=local/secrets/canvas_token.enc
