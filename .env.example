# Copy to .env (ignored by Git). Never put the key in frontend code.
DASHSCOPE_API_KEY=YOUR_OFFICIAL_API_KEY
# Set the exact endpoint from your official console, matching the key region.
QWEN_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# YXIN two-pass grading. The server checks model availability before sending scans.
YXIN_BASE_URL=https://yxai.chat
YXIN_API_KEY=YOUR_YXIN_API_KEY
YXIN_GRADER_56=gpt-5.6-terra
YXIN_REVIEWER_56=gpt-5.6-sol

# Canvas personal access token for live roster and private Inbox reminders.
CANVAS_API_TOKEN=YOUR_CANVAS_API_TOKEN
